{
  "name": "@repo/root",
  "private": true,
  "version": "3.1.0",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "db:check": "pnpm --filter @repo/web db:check",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:pull": "pnpm --filter @repo/web db:pull",
    "db:push": "pnpm --filter @repo/web db:push",
    "db:studio": "pnpm --filter @repo/web db:studio",
    "db:up": "pnpm --filter @repo/web db:up",
    "dev": "pnpm --filter @repo/web dev",
    "dev:demo": "pnpm --filter @repo/web dev:demo",
    "fix": "ultracite fix",
    "prepare": "husky",
    "start": "pnpm --filter @repo/web start",
    "test": "pnpm --filter @repo/web test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,jsonc}": "pnpm run fix --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.7.1",
    "ultracite": "^7.8.4"
  },
  "packageManager": "pnpm@10.32.1"
}
