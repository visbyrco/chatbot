# Example nginx reverse-proxy config for chat.visbyr.com (server.hkjc.uk)
# The app runs as Docker standalone on localhost:3001 (see docker-compose.yml).
# Nginx defaults to client_max_body_size 1m, which returns 413 for any upload
# over 1 MB. The app allows up to 500 MB,
# so the edge must allow at least that plus multipart overhead.

# Place this inside the server { } block for chat.visbyr.com

# Allow uploads up to 500 MB (+ ~50 MB multipart overhead)
client_max_body_size 500m;
client_body_buffer_size 128k;

# Example full server block (adjust TLS/headers to your setup):
